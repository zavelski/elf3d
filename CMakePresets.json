{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "v145,host=x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "windows-manual",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "ELF3D_BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "win-dependencies",
      "inherits": "windows-manual",
      "displayName": "Windows manual dependencies",
      "binaryDir": "${sourceDir}/win/dependencies",
      "cacheVariables": {
        "ELF3D_BUILD_COMPONENT": "dependencies"
      }
    },
    {
      "name": "win-engine",
      "inherits": "windows-manual",
      "displayName": "Windows manual engine",
      "binaryDir": "${sourceDir}/win/engine",
      "cacheVariables": {
        "ELF3D_BUILD_COMPONENT": "engine"
      }
    },
    {
      "name": "win-imgui",
      "inherits": "windows-manual",
      "displayName": "Windows manual imgui",
      "binaryDir": "${sourceDir}/win/imgui",
      "cacheVariables": {
        "ELF3D_BUILD_COMPONENT": "imgui"
      }
    },
    {
      "name": "win-viewer",
      "inherits": "windows-manual",
      "displayName": "Windows manual viewer",
      "binaryDir": "${sourceDir}/win/viewer",
      "cacheVariables": {
        "ELF3D_BUILD_COMPONENT": "viewer"
      }
    },
    {
      "name": "windows-full",
      "displayName": "Windows full (Debug and Release)",
      "binaryDir": "${sourceDir}/out/build/windows-full",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "ELF3D_BUILD_TESTING": "ON",
        "ELF3D_BUILD_APP": "ON",
        "ELF3D_BUILD_ENGINE": "ON",
        "ELF3D_BUILD_VIEWER": "ON",
        "ELF3D_BUILD_PERFORMANCE_BENCHMARK": "ON",
        "ELF3D_BUILD_COMPONENT": "all"
      },
      "inherits": "windows-base"
    },
    {
      "name": "windows-model",
      "displayName": "Windows CPU model (Debug and Release)",
      "binaryDir": "${sourceDir}/out/build/windows-model",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "ELF3D_BUILD_TESTING": "ON",
        "ELF3D_BUILD_APP": "OFF",
        "ELF3D_BUILD_ENGINE": "OFF",
        "ELF3D_BUILD_VIEWER": "OFF",
        "ELF3D_BUILD_PERFORMANCE_BENCHMARK": "OFF",
        "ELF3D_BUILD_COMPONENT": "all"
      },
      "inherits": "windows-base"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-full",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-full",
      "configuration": "Release"
    },
    {
      "name": "windows-model-debug",
      "configurePreset": "windows-model",
      "configuration": "Debug"
    },
    {
      "name": "windows-model-release",
      "configurePreset": "windows-model",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-full",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-full",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-model-debug",
      "configurePreset": "windows-model",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-model-release",
      "configurePreset": "windows-model",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

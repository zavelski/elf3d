#include <winver.h>
#include "elf3d_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ELF3D_FILE_VERSION
 PRODUCTVERSION ELF3D_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef ELF3D_VERSION_DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
#ifdef ELF3D_VERSION_DLL
 FILETYPE VFT_DLL
#else
 FILETYPE VFT_APP
#endif
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Elf3D"
            VALUE "FileVersion", ELF3D_VERSION_STRING
            VALUE "OriginalFilename", ELF3D_BINARY_NAME
            VALUE "ProductName", "Elf3D"
            VALUE "ProductVersion", ELF3D_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
